<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B" />
      <stop offset="50%" stop-color="#EA580C" />
      <stop offset="100%" stop-color="#D97706" />
    </linearGradient>

    <!-- Book Cover Gradient -->
    <linearGradient id="bookGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284C7" />
      <stop offset="100%" stop-color="#0369A1" />
    </linearGradient>

    <!-- Pages Gradient -->
    <linearGradient id="pageGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#F8FAFC" />
    </linearGradient>

    <!-- Gold Accent Gradient -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047" />
      <stop offset="50%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#B45309" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <!-- Drop Shadow -->
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#7C2D12" flood-opacity="0.35" />
    </filter>
  </defs>

  <!-- App Icon Squircle Background -->
  <rect width="512" height="512" rx="115" fill="url(#bgGrad)" />
  
  <!-- Subtle Inner Ring Highlight -->
  <rect x="12" y="12" width="488" height="488" rx="103" fill="none" stroke="#FEF3C7" stroke-width="6" stroke-opacity="0.4" />

  <!-- Background Decorative Rays & Magic Aura -->
  <circle cx="256" cy="240" r="190" fill="#FEF08A" opacity="0.18" filter="url(#glow)" />
  <circle cx="256" cy="240" r="130" fill="#FFFFFF" opacity="0.15" />

  <!-- Three Floating Tense Gem Orbs (Past: Green, Present: Blue, Imperative: Purple) -->
  <!-- Past Orb (Green) -->
  <g transform="translate(90, 110)">
    <circle cx="0" cy="0" r="26" fill="#10B981" filter="url(#shadow)" />
    <circle cx="-6" cy="-6" r="8" fill="#FFFFFF" opacity="0.6" />
    <path d="M-10 0 L-2 8 L10 -4" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Present Orb (Sky Blue) -->
  <g transform="translate(256, 75)">
    <circle cx="0" cy="0" r="28" fill="#0284C7" filter="url(#shadow)" />
    <circle cx="-7" cy="-7" r="9" fill="#FFFFFF" opacity="0.6" />
    <circle cx="0" cy="0" r="14" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-dasharray="3 3"/>
    <polyline points="0,-8 0,0 6,4" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round"/>
  </g>

  <!-- Imperative Orb (Purple) -->
  <g transform="translate(422, 110)">
    <circle cx="0" cy="0" r="26" fill="#8B5CF6" filter="url(#shadow)" />
    <circle cx="-6" cy="-6" r="8" fill="#FFFFFF" opacity="0.6" />
    <polygon points="0,-10 3,-3 10,-3 4,2 6,9 0,5 -6,9 -4,2 -10,-3 -3,-3" fill="#FFFFFF"/>
  </g>

  <!-- Main Open Book Motif -->
  <g filter="url(#shadow)" transform="translate(256, 310)">
    <!-- Book Back / Base -->
    <path d="M-170,40 Q-80,65 0,45 Q80,65 170,40 L160,-70 Q80,-45 0,-65 Q-80,-45 -160,-70 Z" fill="#0C4A6E" />

    <!-- Left Page -->
    <path d="M-160,-70 Q-80,-45 0,-65 L0,45 Q-80,65 -160,40 Z" fill="url(#pageGrad)" stroke="#E2E8F0" stroke-width="2"/>
    <!-- Left Page Curvature Lines -->
    <path d="M-135,-35 Q-75,-15 -20,-30" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M-135,-5 Q-75,15 -20,0" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M-135,25 Q-75,45 -20,30" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round" fill="none"/>

    <!-- Right Page -->
    <path d="M0,-65 Q80,-45 160,-70 L160,40 Q80,65 0,45 Z" fill="url(#pageGrad)" stroke="#E2E8F0" stroke-width="2"/>
    <!-- Right Page Curvature Lines -->
    <path d="M20,-30 Q75,-15 135,-35" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M20,0 Q75,15 135,-5" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M20,30 Q75,45 135,25" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round" fill="none"/>

    <!-- Book Spine Glow -->
    <path d="M-4,-67 L4,-67 L4,47 L-4,47 Z" fill="#F59E0B" />
  </g>

  <!-- Big Stylized Central Arabic Text "فِعْلٌ" -->
  <g filter="url(#shadow)">
    <!-- Decorative Ribbon / Pill behind Text -->
    <rect x="116" y="165" width="280" height="90" rx="45" fill="#FFFFFF" stroke="#FEF08A" stroke-width="4" />
    
    <!-- Arabic Text with Tashkeel -->
    <text x="256" y="230" 
          text-anchor="middle" 
          font-family="'Baloo Bhaijaan 2', 'Tajawal', 'Traditional Arabic', sans-serif" 
          font-size="62" 
          font-weight="900" 
          fill="#7C2D12"
          letter-spacing="2">
      فِعْلٌ
    </text>
  </g>

  <!-- Magic Pencil / Wand Crossing over -->
  <g transform="translate(370, 200) rotate(-40)" filter="url(#shadow)">
    <!-- Pencil Body -->
    <rect x="-14" y="-80" width="28" height="120" rx="6" fill="#F59E0B" stroke="#B45309" stroke-width="2" />
    <rect x="-6" y="-80" width="12" height="120" fill="#FDE047" />
    
    <!-- Pencil Collar -->
    <rect x="-14" y="40" width="28" height="14" fill="#94A3B8" />
    <!-- Pencil Eraser -->
    <rect x="-14" y="54" width="28" height="24" rx="4" fill="#F43F5E" />

    <!-- Pencil Cone Tip -->
    <polygon points="-14,-80 14,-80 0,-115" fill="#FED7AA" stroke="#B45309" stroke-width="2" />
    <!-- Graphite Lead Tip -->
    <polygon points="-6,-98 6,-98 0,-115" fill="#1E293B" />

    <!-- Magic Wand Sparkle at tip -->
    <polygon points="0,-128 4,-120 12,-120 6,-114 9,-106 0,-110 -9,-106 -6,-114 -12,-120 -4,-120" fill="#FDE047" filter="url(#glow)"/>
  </g>

  <!-- Extra Golden Sparkles around the composition -->
  <!-- Top Left Star -->
  <g transform="translate(130, 80) scale(0.9)">
    <polygon points="0,-20 5,-5 20,0 5,5 0,20 -5,5 -20,0 -5,-5" fill="#FEF08A" filter="url(#glow)"/>
  </g>
  <!-- Bottom Left Star -->
  <g transform="translate(80, 400) scale(0.8)">
    <polygon points="0,-20 5,-5 20,0 5,5 0,20 -5,5 -20,0 -5,-5" fill="#FEF08A" filter="url(#glow)"/>
  </g>
  <!-- Right Sparkle -->
  <g transform="translate(435, 380) scale(0.95)">
    <polygon points="0,-20 5,-5 20,0 5,5 0,20 -5,5 -20,0 -5,-5" fill="#FEF08A" filter="url(#glow)"/>
  </g>
  <!-- Small Center Star -->
  <g transform="translate(256, 140) scale(0.6)">
    <polygon points="0,-20 5,-5 20,0 5,5 0,20 -5,5 -20,0 -5,-5" fill="#FEF08A"/>
  </g>

  <!-- Subtitle Badge at bottom -->
  <g transform="translate(256, 440)">
    <rect x="-140" y="-18" width="280" height="36" rx="18" fill="#78350F" opacity="0.9" />
    <text x="0" y="6" text-anchor="middle" font-family="'Tajawal', sans-serif" font-size="16" font-weight="800" fill="#FEF3C7">
      السَّنَةُ الثَّانِيَةُ ابْتِدَائِي
    </text>
  </g>
</svg>
